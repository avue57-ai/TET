# Copy to .env (git-ignored) or add these as environment secrets in the cloud environment.
# Never paste real values into chat, commits, logs, or the database.

# Lemlist REST API key (Basic auth password; user is blank). Enables the direct backend for campaigns, leads, activities, inbox.
LEMLIST_API_KEY=

# Apollo REST API key (sent as x-api-key). Enables direct people search, bulk match, org enrichment.
APOLLO_API_KEY=

# Inven MCP bearer key (issued by an Inven admin via POST /admin-api/mcp-key). Enables the headless MCP-key backend
# against https://api.inven.ai/mcp/v1. This is NOT the enterprise REST API.
INVEN_API_KEY=

# Optional: use the Anthropic SDK instead of the `claude -p` CLI for AI steps.
ANTHROPIC_API_KEY=

# Optional overrides
VERTEX_DB_PATH=data/vertex.db
VERTEX_CONFIG_DIR=config
VERTEX_TZ=America/Detroit
